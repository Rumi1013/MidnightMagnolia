# NEXT_PUBLIC_PORTFOLIO_FEATURED_STATEWIDE_URL=
# NEXT_PUBLIC_PORTFOLIO_FEATURED_DIGITIZATION_URL=

# Private dashboard unlock (server-only — never NEXT_PUBLIC_*)
MM_DASHBOARD_TOKEN=

# ── Security: never prefix secrets with NEXT_PUBLIC_ ─────────────
# Bad (leaks to the browser bundle if set on Vercel as public):
#   NEXT_PUBLIC_WIX_TOKEN / NEXT_PUBLIC_WIX_CLIENT_SECRET
#   NEXT_PUBLIC_*_PAT / NEXT_PUBLIC_*_SECRET / NEXT_PUBLIC_GUMROAD_*
# Good (server-only):
#   WIX_API_KEY, WIX_CLIENT_SECRET, AIRTABLE_API_KEY, GITHUB_TOKEN,
#   GOOGLE_CLIENT_SECRET, GUMROAD_ACCESS_TOKEN, MM_DASHBOARD_TOKEN
# See docs/OPS_ENV.md and docs/WIX_OAUTH_REDIRECTS.md for go-live.
