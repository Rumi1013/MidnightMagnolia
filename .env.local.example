# Production canonical URL — enables <link rel="canonical"> + og:url (use https://www.midnight-magnolia.com )
NEXT_PUBLIC_SITE_URL=https://www.midnight-magnolia.com

# ── Wix Headless ───────────────────────────────────────────────
# Public OAuth client ID — required. Used for read-only public catalog
# (products, services, events, CMS collections). Get it from:
#   Wix Dashboard → Settings → Headless Settings → your OAuth app
NEXT_PUBLIC_WIX_CLIENT_ID=your_wix_client_id_here
WIX_CLIENT_ID=your_wix_client_id_here

# Server-side API key — OPTIONAL. Only set if you need authenticated
# server reads (private data, draft posts, member info, admin scopes).
# Get it from: Wix Dashboard → Settings → API Keys → Generate API Key.
# Copy the value once; it isn't shown again.
# WIX_API_KEY=your_wix_api_key_here
# WIX_SITE_ID=your_wix_site_id_here

# Wix Headless Data: CMS collection ID or name for Digital Grimoire rows
WIX_DATA_COLLECTION_DIGITAL_GRIMOIRE=DigitalGrimoire

NEXT_PUBLIC_PATREON_URL=https://www.patreon.com/your-handle
NEXT_PUBLIC_BMAC_URL=https://www.buymeacoffee.com/your-handle
RESUME_TRACK_A_URL=https://static.wixstatic.com/media/REPLACE.pdf
RESUME_TRACK_B_URL=https://static.wixstatic.com/media/REPLACE.pdf

# ── Dashboard: Notion (lib/notion.js — property names must match) ──────────
NOTION_TOKEN=secret_xxxxx
NOTION_DB_CONTENT_CALENDAR=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_PRODUCT_TRACKER=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_DUSK_LETTERS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Dashboard: Airtable “MM Command” (lib/airtable.js) ─────────────────────
AIRTABLE_API_KEY=pat_xxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx

# Table IDs (tbl…) or names — Airtable_* keys match common .env style; UPPER_SNAKE aliases also work.
Airtable_Content_Pipeline=tblxxxxxxxxxxxxxxxx
# AIRTABLE_CONTENT_PIPELINE=tblxxxxxxxxxxxxxxxx

Airtable_Job_Leads=tblxxxxxxxxxxxxxxxx
Airtable_Job_Applications=tblxxxxxxxxxxxxxxxx
Airtable_Resume_Versions=tblxxxxxxxxxxxxxxxx
Airtable_income_Streams=tblxxxxxxxxxxxxxxxx
Airtable_Daily_Focus=tblxxxxxxxxxxxxxxxx

# Optional — dashboard panels default to these names if unset:
# Airtable_Affiliate_Partners=tblxxxxxxxxxxxxxxxx
# Airtable_Products=tblxxxxxxxxxxxxxxxx