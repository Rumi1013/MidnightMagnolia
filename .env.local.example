# Production canonical URL — enables <link rel="canonical"> + og:url (use https://www.midnight-magnolia.com )
NEXT_PUBLIC_SITE_URL=https://www.midnight-magnolia.com

# ── Wix Headless ───────────────────────────────────────────────
# Public OAuth client ID — required. Used for read-only public catalog
# (products, services, events, CMS collections). Get it from:
#   Wix Dashboard → Settings → Headless Settings → your OAuth app
NEXT_PUBLIC_WIX_CLIENT_ID=your_wix_client_id_here
WIX_CLIENT_ID=your_wix_client_id_here

# Server-side API key — OPTIONAL. Only set if you need authenticated
# server reads (private data, draft posts, member info, admin scopes).
# Get it from: Wix Dashboard → Settings → API Keys → Generate API Key.
# Copy the value once; it isn't shown again.
# WIX_API_KEY=your_wix_api_key_here
# WIX_SITE_ID=your_wix_site_id_here

# Wix Headless Data: CMS collection ID or name for Digital Grimoire rows
WIX_DATA_COLLECTION_DIGITAL_GRIMOIRE=DigitalGrimoire

# Storefront URL — OPTIONAL. Where "Buy" / "Book" links should point.
# Defaults to the URL embedded in the Wix API response (currently
# https://www.midnight-magnolia.com). Set this to a subdomain (e.g.,
# https://wix.midnight-magnolia.com) once Next.js takes over the apex domain.
# NEXT_PUBLIC_WIX_STOREFRONT_URL=https://www.midnight-magnolia.com

NEXT_PUBLIC_PATREON_URL=https://www.patreon.com/your-handle
NEXT_PUBLIC_BMAC_URL=https://www.buymeacoffee.com/your-handle
# Resume PDFs (portfolio downloads). Do not swap without an explicit decision:
#   RESUME_TRACK_A_URL = Archival / preservation resume (primary)
#   RESUME_TRACK_B_URL = Data / systems resume (secondary)
RESUME_TRACK_A_URL=https://static.wixstatic.com/media/REPLACE.pdf
RESUME_TRACK_B_URL=https://static.wixstatic.com/media/REPLACE.pdf
# Optional — Featured portfolio cards 2 & 3 (hosted case studies / Notion public pages)
# NEXT_PUBLIC_PORTFOLIO_FEATURED_GENEALOGY_URL=https://…   (defaults to NEXT_PUBLIC_SITE_URL)
# NEXT_PUBLIC_PORTFOLIO_FEATURED_STATEWIDE_URL=https://…
# NEXT_PUBLIC_PORTFOLIO_FEATURED_DIGITIZATION_URL=https://…

# ── Dashboard: Notion (lib/notion.js — property names must match) ──────────
# After the 6-database restructure (Master Plan v3), paste each database ID here.
NOTION_TOKEN=secret_xxxxx
NOTION_DB_CONTENT_CALENDAR=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_PRODUCT_TRACKER=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_DUSK_LETTERS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Dashboard: Airtable “MM Command” (lib/airtable.js) ─────────────────────
AIRTABLE_API_KEY=pat_xxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx

# Table IDs (tbl…) or names — Airtable_* keys match common .env style; UPPER_SNAKE aliases also work.
Airtable_Content_Pipeline=tblxxxxxxxxxxxxxxxx
# AIRTABLE_CONTENT_PIPELINE=tblxxxxxxxxxxxxxxxx

Airtable_Job_Leads=tblxxxxxxxxxxxxxxxx
Airtable_Job_Applications=tblxxxxxxxxxxxxxxxx
Airtable_Resume_Versions=tblxxxxxxxxxxxxxxxx
Airtable_income_Streams=tblxxxxxxxxxxxxxxxx
Airtable_Daily_Focus=tblxxxxxxxxxxxxxxxx

# Optional — dashboard panels default to these names if unset:
# Airtable_Affiliate_Partners=tblxxxxxxxxxxxxxxxx
# Airtable_Products=tblxxxxxxxxxxxxxxxx
# ── Supabase ───────────────────────────────────────────────────
# Family Tree, Genealogy, Dashboard Tasks all live here
# Project ref is the subdomain: https://<ref>.supabase.co (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # seed script only — never expose client-side
# GENEALOGY_CSV_DIR=completeairtable   # optional — scripts/seed-genealogy.mjs defaults to ./completeairtable

# ── Airtable ────────────────────────────────────────────────────
AIRTABLE_API_KEY=your_airtable_personal_access_token   # Settings > Developer hub > Personal access tokens

# Base 1 — Midnight Operations
AIRTABLE_OPS_BASE_ID=appj7TCIoDQke9S7d

# Midnight Operations table IDs
AIRTABLE_TBL_SOCIAL_LINKS=tblz5jJ5A02jNiZeT
AIRTABLE_TBL_AFFILIATES=tbldPT7csoJ5ArzQ4
AIRTABLE_TBL_PRODUCTS=tblA2WPOZgzeGlEji
AIRTABLE_TBL_CONTENT=tblorZTO0swzz3ekS
AIRTABLE_TBL_SALES=tblNwu5YXc3hCoJgG
AIRTABLE_TBL_CONTACTS=tblmV8mw0CyojcOHB
AIRTABLE_TBL_AFFILIATE_PIPELINE=tblO9ALbn9Un0b6mX
AIRTABLE_TBL_PATREON=tblFSz9A3GHlrX2Fc

# Services inventory tracker (Wix Bookings) — create by importing
# data/inventory-services.csv into the Midnight Operations base, then
# paste the new table's ID here. Dashboard Services panel stays in
# "Not Connected" state until this is set.
# AIRTABLE_TBL_SERVICES=tblxxxxxxxxxxxxxx

# Optional — Career Command panel on /dashboard (see docs/OPS_ENV.md)
# AIRTABLE_CAREER_BASE_ID=appxxxxxxxxxxxxxx

# Base 2 — Writing / Creative
AIRTABLE_WRITING_BASE_ID=appiZEJmrbIH4lVvE

# Writing base table IDs
AIRTABLE_TBL_POSTS=tbl2FEz1L9Jb7Fj74
AIRTABLE_TBL_MANUSCRIPTS=tblwuuzXKB0sQ9Z3T
AIRTABLE_TBL_MANUSCRIPT_TASKS=tblwmFyq3sBAIQLop
AIRTABLE_TBL_BOOKS=tblfBJjIOUlPDCz3s
AIRTABLE_TBL_RESUMES=tblkPLNijXQMQLETB
AIRTABLE_TBL_OPPORTUNITIES=tblTh9CIR4mypfBMT
AIRTABLE_TBL_INCOME=tblzeepWqmnncq50d

# ── Notion (dashboard — same IDs as block above; duplicate removed in favor of NOTION_DB_*) ──
# Prefer NOTION_DB_CONTENT_CALENDAR, NOTION_DB_PRODUCT_TRACKER, NOTION_DB_DUSK_LETTERS (see lib/notion.js).

# ── Wix ─────────────────────────────────────────────────────────
NEXT_PUBLIC_WIX_CLIENT_ID=your_wix_client_id_here
WIX_DATA_COLLECTION_DIGITAL_GRIMOIRE=DigitalGrimoire

# ── Resume CDN URLs (same contract as top of file) ─────────────
#   A = Archival (primary) · B = Data (secondary)
RESUME_TRACK_A_URL=https://static.wixstatic.com/media/REPLACE.pdf
RESUME_TRACK_B_URL=https://static.wixstatic.com/media/REPLACE.pdf
